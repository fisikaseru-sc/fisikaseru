NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
GROQ_API_KEY=your-groq-api-key

# Lokasi sumber referensi fisika bersama (DI LUAR repo — jangan commit PDF).
# Path ini boleh berisi spasi. Bila tidak di-set, default internal dipakai.
PHYSICS_SOURCE_ROOT=/home/si/AI-Workspace/Physics Source

# Observabilitas (G-5). Opsional: bila diisi, endpoint /api/metrics memerlukan
# header `x-metrics-token` yang sama. Bila kosong, endpoint tetap terbuka tetapi
# hanya mengekspos data agregat (tanpa data siswa).
METRICS_TOKEN=
